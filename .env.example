# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=
SUPABASE_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_ALLOWED_HOSTS=
# off | dry-run | live
REPLY_POSTING=off
REPLY_DAILY_LIMIT=10
REPLY_GAP_SECONDS=300
# persistent = collector/profile; personal = attach to your running Chrome (144+).
# For personal mode, enable chrome://inspect/#remote-debugging and allow the connection.
BROWSER_MODE=persistent
# Personal mode + a folder of its own = a separate Chrome just for the tool (start.bat opens it, `npm run login -- <site>` logs in there).
# Leave it out to attach to your own Chrome instead (it may open tabs in whichever profile is active).
# CHROME_USER_DATA_DIR=D:/automation/chrome-bot
