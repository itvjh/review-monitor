# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=
SUPABASE_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_ALLOWED_HOSTS=
# off | dry-run | live
REPLY_POSTING=off
REPLY_DAILY_LIMIT=10
REPLY_GAP_MINUTES=5
# persistent = collector/profile; personal = attach to your running Chrome (144+).
# For personal mode, enable chrome://inspect/#remote-debugging and allow the connection.
BROWSER_MODE=persistent
# CHROME_USER_DATA_DIR=C:/Users/YourName/AppData/Local/Google/Chrome/User Data
